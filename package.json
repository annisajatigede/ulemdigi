{
  "name": "kawinan",
  "version": "2.0.0",
  "private": true,
  "description": "SaaS Platform Undangan Digital Berbayar (Kawinan.id / UlemDigi) - Node.js + Vue 3",
  "scripts": {
    "build": "node build.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "cd backend && npm install && npx prisma generate",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test:e2e": "node backend/test_suite.js",
    "start": "node backend/src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "keywords": [
    "kawinan",
    "ulemdigi",
    "undangan-digital",
    "express",
    "vue3",
    "prisma",
    "mysql"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
