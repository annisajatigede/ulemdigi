generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model guests {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  invitation_id  BigInt             @db.UnsignedBigInt
  name           String             @db.VarChar(255)
  phone          String?            @db.VarChar(255)
  personal_token String             @unique(map: "guests_personal_token_unique") @db.VarChar(255)
  rsvp_status    guests_rsvp_status @default(pending)
  guest_count    Int                @default(1) @db.UnsignedInt
  checked_in_at  DateTime?          @db.Timestamp(0)
  created_at     DateTime?          @db.Timestamp(0)
  updated_at     DateTime?          @db.Timestamp(0)
  invitations    invitations        @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "guests_invitation_id_foreign")
  wishes         wishes[]

  @@index([invitation_id], map: "guests_invitation_id_foreign")
}

model invitation_events {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  invitation_id BigInt      @db.UnsignedBigInt
  title         String      @db.VarChar(255)
  start_at      DateTime    @db.DateTime(0)
  end_at        DateTime?   @db.DateTime(0)
  timezone      String      @default("WIB") @db.VarChar(10)
  venue_name    String      @db.VarChar(255)
  address       String?     @db.Text
  maps_url      String?     @db.Text
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  invitations   invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitation_events_invitation_id_foreign")

  @@index([invitation_id], map: "invitation_events_invitation_id_foreign")
}

model invitations {
  id                BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt               @db.UnsignedBigInt
  template_id       BigInt               @db.UnsignedBigInt
  plan_id           BigInt               @db.UnsignedBigInt
  slug              String               @unique(map: "invitations_slug_unique") @db.VarChar(255)
  category          invitations_category @default(wedding)
  status            invitations_status   @default(draft)
  published_at      DateTime?            @db.Timestamp(0)
  expires_at        DateTime?            @db.Timestamp(0)
  data              Json?
  created_at        DateTime?            @db.Timestamp(0)
  updated_at        DateTime?            @db.Timestamp(0)
  guests            guests[]
  invitation_events invitation_events[]
  plans             plans                @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_plan_id_foreign")
  templates         templates            @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_template_id_foreign")
  users             users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_user_id_foreign")
  transactions      transactions[]
  wishes            wishes[]

  @@index([plan_id], map: "invitations_plan_id_foreign")
  @@index([template_id], map: "invitations_template_id_foreign")
  @@index([user_id], map: "invitations_user_id_foreign")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model musics {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String    @db.VarChar(255)
  artist     String?   @db.VarChar(255)
  category   String    @default("all") @db.VarChar(50)
  file_path  String    @db.VarChar(255)
  is_active  Boolean   @default(true)
  sort_order Int       @default(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model plans {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  code          String         @unique(map: "plans_code_unique") @db.VarChar(255)
  name          String         @db.VarChar(255)
  price         Decimal        @default(0.00) @db.Decimal(12, 2)
  duration_days Int            @default(30) @db.UnsignedInt
  max_photos    Int            @default(5) @db.UnsignedInt
  max_events    Int            @default(1) @db.UnsignedInt
  features      Json?
  created_at    DateTime?      @db.Timestamp(0)
  updated_at    DateTime?      @db.Timestamp(0)
  invitations   invitations[]
  transactions  transactions[]
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model settings {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String    @unique(map: "settings_key_unique") @db.VarChar(255)
  value      String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model templates {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name           String             @db.VarChar(255)
  category       templates_category @default(wedding)
  style          String             @default("classic") @db.VarChar(255)
  thumbnail_path String?            @db.VarChar(255)
  blade_view     String             @db.VarChar(255)
  is_active      Boolean            @default(true)
  created_at     DateTime?          @db.Timestamp(0)
  updated_at     DateTime?          @db.Timestamp(0)
  invitations    invitations[]
}

model transactions {
  id            BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt              @db.UnsignedBigInt
  invitation_id BigInt?             @db.UnsignedBigInt
  plan_id       BigInt              @db.UnsignedBigInt
  order_id      String              @unique(map: "transactions_order_id_unique") @db.VarChar(255)
  amount        Decimal             @db.Decimal(12, 2)
  status        transactions_status @default(pending)
  gateway       String              @default("midtrans") @db.VarChar(255)
  paid_at       DateTime?           @db.Timestamp(0)
  raw_payload   Json?
  created_at    DateTime?           @db.Timestamp(0)
  updated_at    DateTime?           @db.Timestamp(0)
  invitations   invitations?        @relation(fields: [invitation_id], references: [id], onUpdate: NoAction, map: "transactions_invitation_id_foreign")
  plans         plans               @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transactions_plan_id_foreign")
  users         users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transactions_user_id_foreign")

  @@index([invitation_id], map: "transactions_invitation_id_foreign")
  @@index([plan_id], map: "transactions_plan_id_foreign")
  @@index([user_id], map: "transactions_user_id_foreign")
}

model users {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name              String         @db.VarChar(255)
  email             String         @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime?      @db.Timestamp(0)
  password          String         @db.VarChar(255)
  role              users_role     @default(user)
  remember_token    String?        @db.VarChar(100)
  created_at        DateTime?      @db.Timestamp(0)
  updated_at        DateTime?      @db.Timestamp(0)
  invitations       invitations[]
  transactions      transactions[]
}

model wishes {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  invitation_id BigInt      @db.UnsignedBigInt
  guest_id      BigInt?     @db.UnsignedBigInt
  name          String      @db.VarChar(255)
  message       String      @db.Text
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  guests        guests?     @relation(fields: [guest_id], references: [id], onUpdate: NoAction, map: "wishes_guest_id_foreign")
  invitations   invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishes_invitation_id_foreign")

  @@index([guest_id], map: "wishes_guest_id_foreign")
  @@index([invitation_id], map: "wishes_invitation_id_foreign")
}

enum templates_category {
  wedding
  khitan
  general
}

enum guests_rsvp_status {
  attended
  not_attended
  maybe
  pending
}

enum invitations_category {
  wedding
  khitan
  general
}

enum users_role {
  user
  admin
}

enum invitations_status {
  draft
  published
  expired
}

enum transactions_status {
  pending
  paid
  failed
  expired
}
